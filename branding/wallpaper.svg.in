<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <radialGradient id="sky" cx="0.72" cy="0.38" r="0.95">
      <stop offset="0" stop-color="#1D5A3F"/>
      <stop offset="0.55" stop-color="#12382A"/>
      <stop offset="1" stop-color="@DARK@"/>
    </radialGradient>
    <linearGradient id="leafA" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="@ACCENT@"/>
      <stop offset="1" stop-color="@PRIMARY@"/>
    </linearGradient>
    <filter id="blur40"><feGaussianBlur stdDeviation="40"/></filter>
    <filter id="blur6"><feGaussianBlur stdDeviation="6"/></filter>
    <!-- Blattform: Basis bei (0,0), Spitze bei (0,-318) -->
    <path id="leaf" d="M0 6 C -150 -30, -178 -210, 0 -318 C 168 -214, 150 -34, 0 6 Z"/>
  </defs>

  <rect width="1920" height="1080" fill="url(#sky)"/>

  <!-- Weiches Licht -->
  <circle cx="1380" cy="400" r="380" fill="@ACCENT@" fill-opacity="0.10" filter="url(#blur40)"/>

  <!-- Großes Blatt rechts -->
  <g transform="translate(1290 860) rotate(38) scale(2.05)">
    <path d="M0 0 C -4 40, -12 78, -30 110" fill="none" stroke="@ACCENT@" stroke-opacity="0.55" stroke-width="10" stroke-linecap="round"/>
    <use href="#leaf" fill="url(#leafA)" fill-opacity="0.85"/>
    <g fill="none" stroke="@DARK@" stroke-opacity="0.35" stroke-linecap="round">
      <path d="M0 -8 C -6 -110, -4 -200, 0 -292" stroke-width="6"/>
      <path d="M-2 -70  C -30 -88, -58 -96, -86 -98"  stroke-width="4"/>
      <path d="M-2 -140 C -28 -158, -52 -168, -76 -172" stroke-width="4"/>
      <path d="M-1 -205 C -20 -220, -36 -230, -52 -236" stroke-width="3.5"/>
      <path d="M2 -95  C 30 -113, 58 -121, 84 -123"  stroke-width="4"/>
      <path d="M2 -165 C 26 -183, 48 -192, 70 -196" stroke-width="4"/>
      <path d="M1 -228 C 18 -242, 32 -250, 46 -255" stroke-width="3.5"/>
    </g>
  </g>

  <!-- Kleinere, unscharfe Blätter im Hintergrund -->
  <use href="#leaf" fill="@PRIMARY@" fill-opacity="0.35" filter="url(#blur6)" transform="translate(470 330) rotate(-28) scale(0.55)"/>
  <use href="#leaf" fill="@ACCENT@"  fill-opacity="0.18" filter="url(#blur6)" transform="translate(840 980) rotate(64) scale(0.42)"/>
  <use href="#leaf" fill="@PRIMARY@" fill-opacity="0.22" filter="url(#blur6)" transform="translate(1800 230) rotate(-120) scale(0.35)"/>

  <!-- Schwebende Quadrate -->
  <g fill="#FFFFFF">
    <rect x="210"  y="760" width="46" height="46" rx="9" fill-opacity="0.06" transform="rotate(-18 233 783)"/>
    <rect x="330"  y="880" width="26" height="26" rx="6" fill-opacity="0.08" transform="rotate(24 343 893)"/>
    <rect x="640"  y="170" width="34" height="34" rx="7" fill-opacity="0.05" transform="rotate(14 657 187)"/>
    <rect x="1040" y="120" width="22" height="22" rx="5" fill-opacity="0.07" transform="rotate(-30 1051 131)"/>
    <rect x="1700" y="600" width="40" height="40" rx="8" fill-opacity="0.06" transform="rotate(35 1720 620)"/>
    <rect x="980"  y="640" width="28" height="28" rx="6" fill-opacity="0.05" transform="rotate(10 994 654)"/>
    <rect x="120"  y="220" width="24" height="24" rx="5" fill-opacity="0.06" transform="rotate(40 132 232)"/>
  </g>

  <!-- Schriftzug -->
  <text x="96" y="1000" font-family="Cantarell, DejaVu Sans, sans-serif" font-size="40" font-weight="bold" fill="#FFFFFF" fill-opacity="0.75">@NAME@</text>
  <text x="96" y="1036" font-family="Cantarell, DejaVu Sans, sans-serif" font-size="20" fill="#FFFFFF" fill-opacity="0.45">@TAGLINE@</text>
</svg>
