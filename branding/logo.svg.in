<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0.4" y2="1">
      <stop offset="0" stop-color="@ACCENT@"/>
      <stop offset="1" stop-color="@PRIMARY@"/>
    </linearGradient>
    <linearGradient id="leaf" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#FFFFFF"/>
      <stop offset="1" stop-color="#E6EFE9"/>
    </linearGradient>
    <clipPath id="tile"><rect x="24" y="24" width="464" height="464" rx="108"/></clipPath>
  </defs>

  <!-- Hintergrund: abgerundetes Quadrat mit Verlauf -->
  <rect x="24" y="24" width="464" height="464" rx="108" fill="url(#bg)"/>
  <!-- Dezente schwebende Quadrate -->
  <g clip-path="url(#tile)" fill="#FFFFFF" fill-opacity="0.10">
    <rect x="70"  y="330" width="44" height="44" rx="8" transform="rotate(-18 92 352)"/>
    <rect x="120" y="410" width="30" height="30" rx="6" transform="rotate(24 135 425)"/>
    <rect x="380" y="380" width="52" height="52" rx="9" transform="rotate(14 406 406)"/>
    <rect x="330" y="440" width="28" height="28" rx="5" transform="rotate(-30 344 454)"/>
    <rect x="410" y="300" width="26" height="26" rx="5" transform="rotate(35 423 313)"/>
    <rect x="60"  y="90"  width="26" height="26" rx="5" transform="rotate(20 73 103)"/>
  </g>
  <rect x="24" y="24" width="464" height="232" rx="108" fill="#FFFFFF" fill-opacity="0.06"/>

  <!-- Blatt: Spitze oben rechts, Stiel unten links -->
  <g transform="translate(201 318) rotate(42) scale(0.82)">
    <path d="M0 0 C -4 40, -12 78, -30 110" fill="none" stroke="#FFFFFF" stroke-width="20" stroke-linecap="round"/>
    <path d="M0 6 C -150 -30, -178 -210, 0 -318 C 168 -214, 150 -34, 0 6 Z" fill="url(#leaf)"/>
    <!-- Blattadern -->
    <g fill="none" stroke="@PRIMARY@" stroke-linecap="round" stroke-opacity="0.85">
      <path d="M0 -8 C -6 -110, -4 -200, 0 -292" stroke-width="12"/>
      <path d="M-2 -70  C -30 -88, -58 -96, -86 -98"  stroke-width="8"/>
      <path d="M-2 -140 C -28 -158, -52 -168, -76 -172" stroke-width="8"/>
      <path d="M-1 -205 C -20 -220, -36 -230, -52 -236" stroke-width="7"/>
      <path d="M2 -95  C 30 -113, 58 -121, 84 -123"  stroke-width="8"/>
      <path d="M2 -165 C 26 -183, 48 -192, 70 -196" stroke-width="8"/>
      <path d="M1 -228 C 18 -242, 32 -250, 46 -255" stroke-width="7"/>
    </g>
  </g>
</svg>
