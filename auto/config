#!/bin/sh
# Wird von "lb config" aufgerufen. Liest distro.conf und übergibt alles an live-build.
set -e

. ./distro.conf

# Hinweis zu --archive-areas: "contrib" fehlt absichtlich. Sonst nimmt
# live-build Firmware-"Installer" mit (z. B. firmware-b43-installer), die beim
# Bauen fremde Dateien aus dem Internet laden.

lb config noauto \
	--mode debian \
	--system live \
	--distribution "${DEBIAN_SUITE}" \
	--archive-areas "main non-free non-free-firmware" \
	--binary-images iso-hybrid \
	--debootstrap-options "--include=ca-certificates" \
	--debian-installer none \
	--security true \
	--updates true \
	--firmware-chroot true \
	--mirror-bootstrap "${BUILD_MIRROR}" \
	--mirror-chroot "${BUILD_MIRROR}" \
	--mirror-chroot-security "${BUILD_MIRROR_SECURITY}" \
	--mirror-binary "${FINAL_MIRROR}" \
	--mirror-binary-security "${FINAL_MIRROR_SECURITY}" \
	${APT_HTTP_PROXY:+--apt-http-proxy "${APT_HTTP_PROXY}"} \
	--image-name "${DISTRO_ID}-${DISTRO_VERSION}" \
	--iso-application "${DISTRO_NAME}" \
	--iso-publisher "${DISTRO_PUBLISHER}" \
	--iso-volume "${DISTRO_NAME} ${DISTRO_VERSION}" \
	--bootappend-live "boot=live components quiet splash locales=${LOCALE} keyboard-layouts=${KEYBOARD} timezone=${TIMEZONE} hostname=${LIVE_HOSTNAME} username=${LIVE_USERNAME}" \
	"${@}"
