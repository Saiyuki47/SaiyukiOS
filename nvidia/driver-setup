#!/bin/sh
# =====================================================================
#  @NAME@: passende Treiber einrichten, Unnötiges entfernen
#
#   - Grafik: passender NVIDIA-Treiber oder keiner
#   - Secure Boot: Signaturschlüssel für die NVIDIA-Module anmelden
#   - Virtuelle Maschine: nur die passenden Gast-Werkzeuge behalten
#   - Bei der Installation: Btrfs-Schnappschüsse einrichten
#
#  Läuft automatisch während der Installation und kann jederzeit erneut
#  gestartet werden, z. B. nach dem Einbau einer anderen Grafikkarte:
#
#    sudo @ID@-driver-setup             erkennen und einrichten
#    sudo @ID@-driver-setup --dry-run   nur anzeigen, nichts ändern
# =====================================================================
set -e
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"

DRY=0 INSTALLER=0
for arg in "$@"; do
	case "${arg}" in
		--dry-run) DRY=1 ;;
		--installer) INSTALLER=1 ;;  # Aufruf aus dem Installer (Calamares)
		*) echo "Unbekannte Option: ${arg}" >&2; exit 2 ;;
	esac
done

CACHE=/var/cache/@ID@/nvidia-legacy
export DEBIAN_FRONTEND=noninteractive
APT="apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold"

run() { echo "+ $*"; [ "${DRY}" = 1 ] || "$@"; }
installed() {
	dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' "$@" 2>/dev/null | awk '$1 ~ /^.i/ { print $2 }'
}
# Alle Pakete des NVIDIA-Treibers. Nicht dazu gehören:
#  - libxnvctrl0: braucht auch Debians hwloc
#  - firmware-nvidia-graphics: Firmware für den freien Treiber nouveau
nvidia_packages() {
	installed '*nvidia*' 'libcuda1' 'libnvcuvid1' 'libnvoptix1' | grep -vx 'firmware-nvidia-graphics'
}
# NVIDIA-Paketquelle ab-/wieder anschalten. Die Dateien werden nicht gelöscht,
# sondern beiseitegelegt – so lässt sie sich nach einem Kartenwechsel
# wiederherstellen.
REPO_FILES="/etc/apt/sources.list.d/nvidia.list /etc/apt/preferences.d/nvidia.pref /etc/apt/trusted.gpg.d/nvidia.key.binary.asc"
REPO_BACKUP=/usr/share/@ID@/nvidia-repo
remove_nvidia_repo() {
	for f in ${REPO_FILES}; do
		[ -e "${f}" ] || continue
		run install -D -m 644 "${f}" "${REPO_BACKUP}${f}"
		run rm -f "${f}"
	done
}
restore_nvidia_repo() {
	for f in ${REPO_FILES}; do
		[ -e "${REPO_BACKUP}${f}" ] && [ ! -e "${f}" ] && run install -D -m 644 "${REPO_BACKUP}${f}" "${f}"
	done
	return 0
}

echo "Grafikkarten:"
CHOICE="$(/usr/libexec/@ID@/gpu-detect -v)"
case "${CHOICE}" in
	none)        echo "→ Keine NVIDIA-Karte: NVIDIA-Treiber werden nicht gebraucht." ;;
	nouveau)     echo "→ Ältere NVIDIA-Karte: freier Treiber nouveau (im Kernel enthalten)." ;;
	open)        echo "→ NVIDIA-Treiber mit offenen Kernelmodulen (RTX 20 / GTX 16 und neuer)." ;;
	legacy)      echo "→ GTX 750 bis GTX 1080 / Titan V: Debians NVIDIA-Treiber 550 (aktuelle NVIDIA-Treiber unterstützen diese Karten nicht mehr)." ;;
esac

case "${CHOICE}" in
none|nouveau)
	PKGS="$(nvidia_packages)"
	# Ohne NVIDIA-Karte braucht auch nouveau keine Firmware
	[ "${CHOICE}" = "none" ] && PKGS="${PKGS} $(installed firmware-nvidia-graphics)"
	if [ -n "${PKGS}" ]; then
		echo "Entferne nicht benötigte NVIDIA-Treiber ..."
		# shellcheck disable=SC2086
		run ${APT} purge ${PKGS}
	fi
	# DKMS und Kernel-Header werden nur für NVIDIA gebraucht – außer, es
	# hängen noch andere DKMS-Module daran (z. B. VirtualBox).
	if command -v dkms >/dev/null 2>&1 && [ -z "$(dkms status 2>/dev/null)" ]; then
		HEADERS="$(installed 'linux-headers-*')"
		# shellcheck disable=SC2086
		run ${APT} purge dkms ${HEADERS}
	fi
	run ${APT} autoremove --purge
	# NVIDIA-Paketquelle und Zusatzdateien entfernen
	remove_nvidia_repo
	run rm -f /etc/modprobe.d/@ID@-nvidia.conf \
		/usr/lib/systemd/user-environment-generators/60-@ID@-nvidia-vaapi \
		/usr/local/bin/prime-run \
		/usr/local/sbin/@ID@-nvidia-secureboot
	;;
open)
	# Firmware für Debians Rechenzentrums-Treiber (Tesla) wird nie gebraucht
	PKGS="$(installed 'firmware-nvidia-tesla-*')"
	# shellcheck disable=SC2086
	[ -z "${PKGS}" ] || run ${APT} purge ${PKGS}
	if [ -z "$(installed nvidia-kernel-open-dkms)" ]; then
		echo "Wechsle auf den aktuellen NVIDIA-Treiber (benötigt Internet) ..."
		PKGS="$(nvidia_packages)"
		# shellcheck disable=SC2086
		[ -z "${PKGS}" ] || run ${APT} purge ${PKGS}
		restore_nvidia_repo
		run apt-get update
		run ${APT} install nvidia-driver nvidia-kernel-open-dkms nvidia-settings nvidia-vaapi-driver
		run ${APT} autoremove --purge
	fi
	;;
legacy)
	if [ -z "$(installed nvidia-kernel-dkms)" ] || [ -n "$(installed nvidia-kernel-open-dkms)" ]; then
		echo "Wechsle auf Debians NVIDIA-Treiber 550 ..."
		# 1) Aktuellen NVIDIA-Treiber (unterstützt diese Karte nicht) entfernen –
		#    ohne autoremove, damit gemeinsame Abhängigkeiten erhalten bleiben.
		PKGS="$(nvidia_packages)"
		# shellcheck disable=SC2086
		[ -z "${PKGS}" ] || run ${APT} purge ${PKGS}
		# 2) NVIDIA-Paketquelle abschalten, sonst würde wieder 595+ gewählt
		remove_nvidia_repo
		# 3) Debians Treiber installieren – offline aus dem mitgebrachten Zwischenspeicher
		#    Die Pakete kommen in apts eigenen Zwischenspeicher – dort nimmt apt
		#    sie ohne Download (als lokale Dateien würde es sie neu laden wollen).
		LEGACY_PKGS="nvidia-driver nvidia-kernel-dkms nvidia-settings nvidia-vaapi-driver"
		if ls "${CACHE}"/*.deb >/dev/null 2>&1 && run cp "${CACHE}"/*.deb /var/cache/apt/archives/ && \
		   run ${APT} --no-download install ${LEGACY_PKGS}; then
			run apt-get clean
		else
			echo "Zwischenspeicher unvollständig – lade aus dem Internet ..."
			run apt-get update
			run ${APT} install ${LEGACY_PKGS}
		fi
		run ${APT} autoremove --purge
	fi
	;;
esac

# Zwischengespeicherte Ausweich-Pakete werden danach nicht mehr gebraucht
run rm -rf "${CACHE}"
echo "Grafiktreiber eingerichtet: ${CHOICE}"

# --- Secure Boot ------------------------------------------------------------------
if [ "${CHOICE}" = "legacy" ] || [ "${CHOICE}" = "open" ]; then
	run /usr/local/sbin/@ID@-nvidia-secureboot || \
		echo "Hinweis: Secure Boot ließ sich nicht einrichten – später 'sudo @ID@-nvidia-secureboot' ausführen."
fi

# --- Virtuelle Maschine: nur die passenden Gast-Werkzeuge behalten -------------------
VIRT="$(systemd-detect-virt --vm 2>/dev/null || true)"
case "${VIRT}" in
	microsoft) KEEP="hyperv-daemons";                       VIRT_NAME="Hyper-V" ;;
	vmware)    KEEP="open-vm-tools open-vm-tools-desktop";  VIRT_NAME="VMware" ;;
	kvm|qemu)  KEEP="qemu-guest-agent spice-vdagent";       VIRT_NAME="QEMU/KVM" ;;
	oracle)    KEEP="";  VIRT_NAME="VirtualBox (Treiber im Kernel enthalten)" ;;
	*)         KEEP="";  VIRT_NAME="keine (echte Hardware)" ;;
esac
echo "Virtuelle Maschine: ${VIRT_NAME}"
DROP=""
for pkg in hyperv-daemons open-vm-tools open-vm-tools-desktop qemu-guest-agent spice-vdagent; do
	case " ${KEEP} " in *" ${pkg} "*) continue ;; esac
	[ -z "$(installed "${pkg}")" ] || DROP="${DROP} ${pkg}"
done
if [ -n "${DROP}" ]; then
	echo "Entferne nicht benötigte Gast-Werkzeuge:${DROP}"
	# shellcheck disable=SC2086
	run ${APT} purge ${DROP}
fi
run ${APT} autoremove --purge

# --- Btrfs-Schnappschüsse (nur bei der Installation) ----------------------------------
if [ "${INSTALLER}" = 1 ]; then
	if [ "$(findmnt -n -o FSTYPE /)" = "btrfs" ]; then
		echo "Richte Btrfs-Schnappschüsse ein (Snapper, grub-btrfs) ..."
		if [ ! -f /etc/snapper/configs/root ]; then
			run snapper --no-dbus -c root create-config /
			# Keine stündlichen Schnappschüsse; dazu automatisch vor/nach jedem Update (apt)
			run sed -i -e 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/' \
				-e 's/^NUMBER_LIMIT=.*/NUMBER_LIMIT="10"/' \
				-e 's/^NUMBER_LIMIT_IMPORTANT=.*/NUMBER_LIMIT_IMPORTANT="5"/' /etc/snapper/configs/root
		fi
		run snapper --no-dbus -c root create --description "Nach der Installation" --userdata important=yes
		run systemctl enable grub-btrfsd.service snapper-cleanup.timer
		run update-grub
	else
		echo "Kein Btrfs: Schnappschuss-Werkzeuge werden nicht gebraucht."
		run ${APT} purge snapper btrfs-assistant
		run ${APT} autoremove --purge
		run rm -rf /etc/grub.d/41_snapshots-btrfs /etc/default/grub-btrfs /usr/bin/grub-btrfsd \
			/usr/lib/systemd/system/grub-btrfsd.service \
			/etc/initramfs-tools/scripts/local-bottom/@ID@-snapshot-overlay
	fi
fi
exit 0
